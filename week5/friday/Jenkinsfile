pipeline {
    agent any

    environment {
        NEXUS_URL      = 'http://172.17.0.1:8081'
        NEXUS_REPO     = 'npm-kijanikiosk'
        NEXUS_CREDS_ID = 'nexus-publisher-creds'
        GIT_SHA_SHORT  = "${GIT_COMMIT.take(7)}"
    }

    stages {
        stage('Clone Repo') {
            steps {
                git url: 'https://github.com/KageniSally/KijanaKiosk.git', branch: 'feature/week5-ci-pipeline'
            }
        }

        stage('Lint') {
            agent {
                docker { image 'node:18.20.4-alpine' }
            }
            steps {
                sh 'npm ci'
                sh 'npm run lint'
            }
        }

        stage('Build') {
            agent {
                docker { image 'node:18.20.4-alpine' }
            }
            steps {
                sh 'npm ci'
                sh 'npm run build'
            }
        }

        stage('Verify') {
            parallel {
                stage('Test') {
                    agent {
                        docker { image 'node:18.20.4-alpine' }
                    }
                    steps {
                        sh 'npm ci'
                        sh 'npm test'
                    }
                }
                stage('Security Audit') {
                    agent {
                        docker { image 'node:18.20.4-alpine' }
                    }
                    steps {
                        sh 'npm ci'
                        sh 'npm audit --audit-level=high'
                    }
                }
            }
        }

        stage('Archive') {
            agent {
                docker { image 'node:18.20.4-alpine' }
            }
            steps {
                sh 'npm ci && npm run build'
                sh 'tar -czf kijanikiosk-payments-build.tar.gz dist/'
                archiveArtifacts artifacts: '*.tar.gz', fingerprint: true
            }
        }

        stage('Publish') {
            agent {
                docker { image 'node:18.20.4-alpine' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.NEXUS_CREDS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    sh '''
                        npm version 1.0.0-${GIT_SHA_SHORT} --no-git-tag-version
                        echo "//172.17.0.1:8081/repository/${NEXUS_REPO}/:_auth=$(echo -n ${NEXUS_USER}:${NEXUS_PASS} | base64)" > .npmrc
                        echo "registry=${NEXUS_URL}/repository/${NEXUS_REPO}/" >> .npmrc
                        npm publish
                        rm -f .npmrc
                    '''
                }
            }
        }
    }

    post {
        always { cleanWs() }
        success { echo 'Published to Nexus successfully.' }
        failure { echo 'Pipeline failed — check console output.' }
        changed { echo "Build result changed to: ${currentBuild.currentResult}" }
    }
}