pipeline{
    agent any
    stages{
        stage("clone repo"){
            steps{
                git url:"https://github.com/KageniSally/KijanaKiosk.git", branch:"feature/week5-ci-pipeline"
            }
        }
        stage("Build repo"){
            steps{
                sh "./gradlew build"
            }
        }
        stage("Test Code"){
            steps{
                sh "./gradlew test"
            }
        }
    }
}